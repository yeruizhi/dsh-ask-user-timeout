{
  "name": "dsh-ask-user-timeout",
  "description": "Guard plugin for DeepSeek Harness: gives ask_user_question a bounded lifetime so a question nobody renders cannot hang the loop forever",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/index.d.ts",
    "lib/types/invariant.d.ts",
    "README.md",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "guard",
    "timeout"
  ],
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.json && tsc -p tsconfig.json --emitDeclarationOnly false --outDir lib --declaration false --module esnext --moduleResolution bundler"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-timeout": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
